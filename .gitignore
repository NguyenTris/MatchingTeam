# ==============================================================================
# Comprehensive .gitignore for MatchingTeam (Node.js/Next.js + Python/FastAPI)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Variables (CRITICAL: Do NOT commit secrets!)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local

# Always allow committing example environment files
!.env.example
!**/.env.example
!**/.env*.example

# Private Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.kdb
*.keystore
id_rsa*
id_ed25519*

# ------------------------------------------------------------------------------
# 2. Python & FastAPI Environment
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python Testing, Linters & Tools
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 3. Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output
.next/
out/
.turbo/

# TypeScript & Linter Caches
*.tsbuildinfo
.eslintcache
.stylelintcache

# Frontend Test & Coverage
coverage/
.nyc_output/

# Package managers cache / temp
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------------------------------------------
# 4. Logs & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*

# ------------------------------------------------------------------------------
# 5. Databases, Local Storage & Uploads
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
postgres_data/
mysql_data/
redis_data/
data/
db_data/
*.pid
*.seed
*.pid.lock

# User uploads, media & runtime temporary files
uploads/
media/
tmp/
temp/

# ------------------------------------------------------------------------------
# 6. OS & IDE Specific
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encrypt
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# JetBrains (IntelliJ, PyCharm, WebStorm, etc.)
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# AI Assistants & Dev Tools
.gemini/
.antigravity/
.cursor/

# Temporary & backup files
*.swp
*.swo
*.bak
*.tmp
*.temp
*.orig
*.rej

# ------------------------------------------------------------------------------
# 7. Docker & Deployment Overrides
# ------------------------------------------------------------------------------
docker-compose.override.yml
docker-compose*.override.yml
docker-compose.local.yml
