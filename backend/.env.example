# MatchingTeam Backend Environment Variables
PROJECT_NAME="MatchingTeam API"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Google Gemini AI (google-genai)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Supabase Credentials (optional if using local Postgres)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-key"

# Security
SECRET_KEY="generate_a_very_strong_random_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/matching_db"

# CORS Origins
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
